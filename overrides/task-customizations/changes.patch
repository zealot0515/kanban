+const proxyArgs = [
+	"-c",
+	'model_provider="cliproxy"',
+	"-c",
+	'model_providers.cliproxy={ name="CLIProxyAPI", base_url="https://proxy.example/v1", env_key="OPENAI_API_KEY", wire_api="responses", requires_openai_auth=false }',
